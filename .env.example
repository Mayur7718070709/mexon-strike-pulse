# Application
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1
FRONTEND_ORIGIN=http://localhost:3000

# Supabase PostgreSQL. Use the transaction pooler/direct connection string from Supabase.
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# DhanHQ v2 credentials. Keep these server-side; never expose them to the frontend.
DHAN_CLIENT_ID=YOUR_DHAN_CLIENT_ID
DHAN_ACCESS_TOKEN=YOUR_DHAN_ACCESS_TOKEN
DHAN_HTTP_TIMEOUT_SECONDS=5
DHAN_CACHE_ENABLED=false
# Comma-separated exchange-segment and security-ID pairs copied from the current official Dhan instrument master.
DHAN_INSTRUMENTS=
DHAN_FEED_MODE=ticker
MARKET_DATA_STALE_AFTER_SECONDS=15
EMBEDDED_WORKER_ENABLED=false

# Supabase Auth JWT verification (configure with your project's signing secret/JWKS as appropriate).
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
